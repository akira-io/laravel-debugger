# Normalize line endings to LF for all text files
* text=auto eol=lf

## Overrides for specific file types
# Windows scripts: keep CRLF in working tree
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell and scripts
*.sh text eol=lf

# Reduce noisy diffs for lockfiles
composer.lock -diff
package-lock.json -diff
pnpm-lock.yaml -diff
yarn.lock -diff

## Binary files (never modify line endings)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.gz  binary
*.tar binary
*.tgz binary
*.7z  binary
*.mp4 binary
