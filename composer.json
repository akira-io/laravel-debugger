{
  "name": "akira/laravel-debugger",
  "description": "Advanced debugging toolkit for Laravel 12+ built with PHP 8.4 features.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "akira",
    "laravel",
    "debugger",
    "debug",
    "laravel-12",
    "php-8.4"
  ],
  "require": {
    "php": "^8.4",
    "illuminate/support": "^12.0 || ^13.0",
    "illuminate/collections": "^12.0 || ^13.0",
    "illuminate/contracts": "^12.0 || ^13.0",
    "illuminate/database": "^12.0 || ^13.0",
    "illuminate/queue": "^12.0 || ^13.0",
    "symfony/var-dumper": "^6.0|^7.0|^8.0",
    "symfony/stopwatch": "^6.0|^7.0|^8.0",
    "spatie/backtrace": "^1.8",
    "spatie/ray": "^1.41 ",
    "zbateson/mail-mime-parser": "^2.0|^3.0"
  },
  "require-dev": {
    "laravel/framework": "^12.0",
    "laravel/pint": "^1.16",
    "phpstan/phpstan": "^1.10|^2.0",
    "pestphp/pest": "^4.0",
    "pestphp/pest-plugin-laravel": "^4.0",
    "rector/rector": "^0.19|^1.0|^2.0",
    "orchestra/testbench": "^10.0 || ^11.0",
    "guzzlehttp/guzzle": "^7.8"
  },
  "autoload": {
    "psr-4": {
      "Akira\\Debugger\\": "src/"
    },
    "files": [
      "src/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Akira\\Debugger\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    },
    "sort-packages": true,
    "autoloader-suffix": "AkiraDebugger"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Akira\\Debugger\\DebuggerServiceProvider"
      ]
    }
  },
  "scripts": {
    "analyse": "vendor/bin/phpstan analyse",
    "format": "vendor/bin/pint",
    "lint": [
      "rector",
      "pint"
    ],
    "test:lint": "pint --test",
    "test:refactor": "rector --dry-run",
    "test:types": "phpstan",
    "test": [
      "@test:lint",
      "@test:refactor",
      "@test:types",
      "pest --parallel"
    ]
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
